# Copier ce fichier en .env.local et remplir les valeurs (ne jamais committer .env.local)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (ex. https://jazzimmo.fr)
NEXT_PUBLIC_BASE_URL=

# Administrateurs (emails séparés par des virgules)
ADMIN_EMAILS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails (Resend)
RESEND_API_KEY=

# Protection des routes /api/cron/*
CRON_SECRET=
